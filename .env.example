# Bu dosyayı ".env" olarak kopyalayıp doldurun. .env git'e gönderilmez.

# ── Docker Compose / Caddy ──
DOMAIN=transkript.example.com

# ── Zorunlu ──
GROQ_API_KEY=gsk_...

# ── İsteğe bağlı (değerler varsayılanlardır) ──
# IP başına saatlik limitler
RATE_PER_HOUR=10
RATE_SUMMARY_PER_HOUR=30
# Aynı anda çalışacak transkripsiyon sayısı (RAM/CPU'ya göre ayarlayın)
MAX_CONCURRENT_JOBS=2
MAX_UPLOAD_MB=500
# URL ile indirmeye izin verilen siteler (virgülle). Boş: tüm genel adresler.
# Önerilen: URL_ALLOWED_HOSTS=youtube.com,youtu.be
URL_ALLOWED_HOSTS=
# Özetleme modeli (Groq'ta mevcut olmalı)
SUMMARY_MODEL=openai/gpt-oss-120b
# YouTube indirme sorun çıkarırsa denenebilir: YTDLP_YOUTUBE_CLIENTS=android,ios
YTDLP_YOUTUBE_CLIENTS=
LOG_LEVEL=INFO
