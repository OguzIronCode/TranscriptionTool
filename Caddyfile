# DOMAIN .env dosyasından gelir (örn. transkript.example.com). HTTPS sertifikası otomatik alınır.
{$DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Yükleme sınırı uygulamadaki MAX_UPLOAD_MB (varsayılan 500) ile uyumlu
	request_body {
		max_size 510MB
	}

	reverse_proxy app:8000 {
		# Uzun transkripsiyon işlemlerinde bağlantı kopmasın
		transport http {
			response_header_timeout 15m
			read_timeout 15m
			write_timeout 15m
		}
	}
}
